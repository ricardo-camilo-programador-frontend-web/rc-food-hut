    "@angular/compiler-cli": "^20.3.34",
    "@angular/platform-browser-dynamic": "^20.3.34",
    "@sonar/scan": "^5.0.2",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "angular-eslint": "^20.0.0",
