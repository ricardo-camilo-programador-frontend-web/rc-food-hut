{
  "name": "angular.dev",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npx tsx scripts/generate-env.ts && ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "ng lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sonar": "sonar-scanner -Dsonar.host.url=http://localhost:9000 -Dsonar.token=$SONAR_TOKEN",
    "sonar:docker": "docker run --rm -v \"$PWD:/usr/src\" -w /usr/src -e SONAR_TOKEN=\"$SONAR_TOKEN\" -e SONAR_HOST_URL=\"$SONAR_HOST_URL\" sonarsource/sonar-scanner-cli:latest -Dsonar.token=\"$SONAR_TOKEN\" -Dsonar.host.url=\"$SONAR_HOST_URL\"",
    "security:scan": "npx tsx scripts/security/security-scan.ts",
    "security:clean": "npx tsx scripts/security/security-clean.ts",
    "security:quick": "npx tsx scripts/security/security-scan.ts --quick",
    "security:report": "npx tsx scripts/security/security-scan.ts --output security-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^1.14.0",
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/platform-browser-dynamic": "19.2.20",
    "@sonar/scan": "^4.3.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "angular-eslint": "19.8.1",
    "autoprefixer": "^10.4.20",
    "copyfiles": "^2.4.1",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.5.0",
    "jasmine-marbles": "~0.9.2",
    "jasmine-spec-reporter": "~7.0.0",
    "jsdom": "^25.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.0",
    "protractor": "~7.0.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "~10.9.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "8.33.1",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  }
}