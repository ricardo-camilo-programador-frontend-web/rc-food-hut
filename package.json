{
  "name": "angular.dev",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npx tsx scripts/generate-env.ts && ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "ng lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sonar": "sonar-scanner -Dsonar.host.url=http://localhost:9000 -Dsonar.token=$SONAR_TOKEN",
    "sonar:docker": "docker run --rm -v \"$PWD:/usr/src\" -w /usr/src -e SONAR_TOKEN=\"$SONAR_TOKEN\" -e SONAR_HOST_URL=\"$SONAR_HOST_URL\" sonarsource/sonar-scanner-cli:latest -Dsonar.token=\"$SONAR_TOKEN\" -Dsonar.host.url=\"$SONAR_HOST_URL\"",
    "security:scan": "npx tsx scripts/security/security-scan.ts",
    "security:clean": "npx tsx scripts/security/security-clean.ts",
    "security:quick": "npx tsx scripts/security/security-scan.ts --quick",
    "security:report": "npx tsx scripts/security/security-scan.ts --output security-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/common": "^20.3.34",
