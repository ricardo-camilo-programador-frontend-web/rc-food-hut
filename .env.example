# Environment Variables - angular-chronicles-part-1 (Food Hut)
# Copy this file to .env and fill in your values.
# Angular does not use .env files at runtime; these are documented here for reference.
# Site/social values are baked in by scripts/generate-env.ts at build time.

# Site URL (used for SEO canonical, Open Graph, structured data)
VITE_SITE_URL=https://food-hut-angular-chronicles-1.netlify.app/

# Portfolio
VITE_PORTFOLIO_URL=https://ricardo-camilo-dev-frontend-web.netlify.app/

# Social Links
VITE_GITHUB_URL=https://github.com/ricardo-camilo-programador-frontend-web
VITE_LINKEDIN_URL=https://www.linkedin.com/in/ricardo-camilo-programador-frontend-web-developer/
VITE_X_URL=https://x.com/Ricardo50993066
VITE_INSTAGRAM_URL=https://www.instagram.com/ricardo.camilo.dev/
VITE_YOUTUBE_URL=https://www.youtube.com/@ricardocamilodev
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61571852212026

# Freelance Platforms
VITE_99FREELAS_URL=https://www.99freelas.com.br/user/CamillusBloodfallen
VITE_WORKANA_URL=https://www.workana.com/freelancer/7a5de74a4785b737b517d8746a01cd23

# Support
VITE_BUYMEACOFFEE_URL=https://buymeacoffee.com/ricardo.camilo.frontend

# Design
