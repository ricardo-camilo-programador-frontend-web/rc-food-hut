# Contact
VITE_CONTACT_EMAIL=ricardo.camilo.dev@gmail.com

# Analytics (single source of truth: src/lib/analytics/config.ts — NG_APP_* > VITE_* legacy > defaults)
NG_APP_ANALYTICS_ENABLED=true
NG_APP_CLARITY_ID=yyrpw7vjoz
NG_APP_GA4_ID=G-MSX663TSDY
NG_APP_GTM_ENABLED=false
NG_APP_GTM_ID=
NG_APP_GTM_GA4_ID=
NG_APP_COUNTER_ID=f30df6f3-776d-4154-959d-0210ac8a8325
NG_APP_COUNTER_UTCOFFSET=-3

